# Database (Railway or other PostgreSQL)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Admin panel protection
ADMIN_PASSWORD="your-secure-password"

# Vercel Blob (for menu item images; get from Vercel project → Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Razorpay (Dashboard → Settings → API Keys; use test keys for testing)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Razorpay Webhook (Dashboard → Settings → Webhooks → Add endpoint; copy "Secret")
RAZORPAY_WEBHOOK_SECRET="..."

# Firebase (Phone OTP login)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (server-side token verification)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Customer session signing secret (random long string)
SESSION_SECRET=""
