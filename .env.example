# Database (Railway or other PostgreSQL)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Admin panel protection
ADMIN_PASSWORD="your-secure-password"

# Vercel Blob (for menu item images; get from Vercel project → Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Razorpay (Dashboard → Settings → API Keys; use test keys for testing)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Razorpay Webhook (Dashboard → Settings → Webhooks → Add endpoint; copy "Secret")
RAZORPAY_WEBHOOK_SECRET="..."
