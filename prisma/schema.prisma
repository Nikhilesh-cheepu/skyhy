// Prisma schema for SKYHY Live — production PostgreSQL
// DATABASE_URL = runtime (pooled); DIRECT_URL = migrations (direct)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Use DIRECT_URL for migrations when using a connection pooler (e.g. PgBouncer).
  // For local dev or single URL, omit directUrl and Prisma uses DATABASE_URL for both.
  directUrl = env("DIRECT_URL")
}

// ─── Menu structure (normalized) ─────────────────────────────────────────────
// Sections: food | beverage | liquor | store | special-128
model Section {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  categories Category[]
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([slug])
}

// Categories within a section (e.g. salad, veg-starters, mocktail)
model Category {
  id        String    @id @default(cuid())
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  sortOrder Int       @default(0)
  menuItems MenuItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([sectionId, slug])
  @@index([sectionId])
}

// Menu item — price in smallest unit (e.g. rupees as integer). imageUrl = Vercel Blob URL only.
model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Int      // integer currency (e.g. ₹379 → 379)
  category    String   // veg | non-veg | beverage | liquor | store
  imageUrl    String?  // Vercel Blob URL only; no binary in DB
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  categoryId  String
  categoryRef Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([sectionId])
  @@index([categoryId])
  @@index([isActive])
}

// ─── Media & content ────────────────────────────────────────────────────────
model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model HeroMedia {
  id        String   @id @default(cuid())
  type      String   // video | image
  url       String
  posterUrl String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─── Homepage offers & events ────────────────────────────────────────────────

enum OfferCtaType {
  VIEW_MENU
  BOOK_TICKETS
  VIEW_PACKAGES
}

model Offer {
  id        String       @id @default(cuid())
  title     String
  ctaType   OfferCtaType
  mediaType String       // image | video
  mediaUrl  String       // Vercel Blob URL only
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([sortOrder])
}

model Event {
  id          String          @id @default(cuid())
  title       String?
  eventDate   DateTime?
  endDate     DateTime?
  ticketPrice Int             @default(0)
  mediaType   String          // image | video
  mediaUrl    String          // Vercel Blob URL only
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  notes       String?
  bookings    EventBooking[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model EventBooking {
  id               String   @id @default(cuid())
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  fullName         String
  mobile           String
  userId           String?
  date             DateTime
  time             String
  people           Int
  ticketPrice      Int      @default(0)
  paymentStatus   String   @default("PENDING")
  razorpayOrderId  String?  // Razorpay order id; webhook confirms payment
  createdAt        DateTime @default(now())

  @@index([razorpayOrderId])
  @@index([userId, date])
}

// ─── Menu gallery images ──────────────────────────────────────────────────────

model MenuGalleryImage {
  id        String   @id @default(cuid())
  url       String
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model ContactClick {
  id        String   @id @default(cuid())
  type      String   // whatsapp | call
  createdAt DateTime @default(now())

  @@index([type])
}

// ─── Future: orders, payments (placeholders — add when needed) ───────────────

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills        Bill[]
  coupons      Coupon[]
  couponClaims CouponClaim[]
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
}

model Order {
  id               String      @id @default(cuid())
  userId           String?
  customerName     String?
  customerPhone    String?
  totalAmount      Int
  status           String      @default("PENDING") // PENDING → PAID via webhook
  razorpayOrderId  String?
  items            OrderItem[]
  couponClaims     CouponClaim[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([razorpayOrderId])
  @@index([userId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Int
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
}

model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  description    String?
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  discountAmount Int?          // flat discount in rupees
  discountPercent Int?         // percentage discount
  minBillAmount  Int?          // minimum bill amount to apply
  status         CouponStatus  @default(ACTIVE)
  dayKey         String?       // YYYY-MM-DD (IST) for daily quota/uniqueness
  issuedAt       DateTime?
  expiresAt      DateTime?
  reservationId  String?       // optional link to reservation/booking
  // If you later want a strict relation to EventBooking, you can add a relation here.
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bills          Bill[]

  @@index([dayKey])
  @@unique([userId, dayKey])
  @@index([userId, dayKey])
}

model CouponDay {
  dayKey      String   @id
  issuedCount Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Bill {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Int
  billType          String      @default("a_la_carte") // a_la_carte | 128 (25% only on à la carte, not on 128-only)
  notes             String?
  status            BillStatus  @default(PENDING)
  paidAmount        Int         @default(0)  // amount received so far (for PARTIAL)
  paidAt             DateTime?   // when marked PAID or last partial
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  couponClaims CouponClaim[]

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

enum CouponClaimStatus {
  HELD
  USED
  RELEASED
}

model CouponClaim {
  id              String            @id @default(cuid())
  dayKey          String
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId          String?
  bill            Bill?             @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          CouponClaimStatus @default(HELD)
  holdExpiresAt   DateTime
  discountAmount  Int?
  discountPercent Int?
  createdAt       DateTime         @default(now())

  @@unique([dayKey, userId])
  @@unique([dayKey, billId])
  @@unique([dayKey, orderId])
  @@index([dayKey])
  @@index([billId])
  @@index([orderId])
}


